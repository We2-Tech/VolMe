# ---- App ----
NODE_ENV=development

# ---- Mongo ----
# A fresh, empty database. The v1 data is NOT migrated (see
# docs/decisions/0001-rewrite-on-nextjs-template.md).
# In docker-compose this defaults to the bundled `mongo` service.
MONGO_URI=mongodb://localhost:27017/volme
# Host port the compose `mongo` service publishes on 127.0.0.1. Change it (here and
# in MONGO_URI) if something else already holds 27017 on this machine.
MONGO_PORT=27017

# ---- Auth.js ----
# VolMe has no passwords: Google OAuth, or an emailed magic link.
# See docs/decisions/0008-passwordless-authentication.md
# Generate with: openssl rand -base64 32. Rotating it signs everyone out.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Optional. Without these the Google button is hidden and email still works.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Sends the sign-in link. Unset in development, the link is printed to the server
# console instead; in production its absence is a hard error.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="VolMe <noreply@volme.org>"

# ---- Cloudflare R2 uploads ----
# Server-side only. Never prefix these with NEXT_PUBLIC_ — the browser gets a
# short-lived presigned URL from a Route Handler, never the credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public base URL for reads (an R2 custom domain, or an r2.dev subdomain).
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ---- Google Maps (P5) ----
# Public by design (it ships in the browser bundle). Restrict it by HTTP
# referrer in the Google Cloud console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Transactional email ----
# Application and invitation mail reuses AUTH_RESEND_KEY above. Without it, in
# development, mail is logged to the server console instead of sent.

# ---- PayPal (P4, only if the paid tiers survive the P0-4 decision) ----
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- Optional: Cloudflare tunnel ----
# Only needed if you run the `tunnel` service (docker compose --profile tunnel up -d).
# Create a tunnel in the Cloudflare Zero Trust dashboard, point its public
# hostname to http://nginx:8080, and paste the token it gives you here.
# TUNNEL_TOKEN=
