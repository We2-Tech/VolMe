# ---- App ----
NODE_ENV=development

# ---- Mongo ----
# A fresh, empty database. The v1 data is NOT migrated (see
# docs/decisions/0001-rewrite-on-nextjs-template.md).
# In docker-compose this defaults to the bundled `mongo` service.
MONGO_URI=mongodb://localhost:27017/volme

# ---- Auth.js (P3) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ---- Cloudflare R2 uploads (P4) ----
# Server-side only. Never prefix these with NEXT_PUBLIC_ — the browser gets a
# short-lived presigned URL from a Route Handler, never the credentials.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Public base URL for reads (an R2 custom domain, or an r2.dev subdomain).
# NEXT_PUBLIC_R2_PUBLIC_URL=

# ---- Google Maps (P5) ----
# Public by design (it ships in the browser bundle). Restrict it by HTTP
# referrer in the Google Cloud console.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Email (P4) ----
# RESEND_API_KEY=

# ---- PayPal (P4, only if the paid tiers survive the P0-4 decision) ----
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---- Optional: Cloudflare tunnel ----
# Only needed if you run the `tunnel` service (docker compose --profile tunnel up -d).
# Create a tunnel in the Cloudflare Zero Trust dashboard, point its public
# hostname to http://nginx:8080, and paste the token it gives you here.
# TUNNEL_TOKEN=
